# Copia a .env; no publiques .env en Git.
CI_ENVIRONMENT = development

app.baseURL = 'http://127.0.0.1:8080/'
app.indexPage = ''
app.defaultLocale = 'es'
app.appTimezone = 'America/Guayaquil'

# Base de datos en writable/.
database.default.DBDriver = SQLite3
database.default.database = sipac.db

# Tokens CSRF asociados a la sesión.
security.csrfProtection = session
